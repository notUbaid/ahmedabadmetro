# OpenRouteService API Key for accurate walking route calculations
# Get your API key from: https://openrouteservice.org/dev/#/signup
# Sign up for free tier at https://openrouteservice.org to get an API key

# For local development:
VITE_ORS_API_KEY=your_api_key_here

# For Vercel deployment:
# Set ORS_API_KEY environment variable in Vercel project settings
# Go to: Project Settings > Environment Variables > Add Variable
# Name: ORS_API_KEY
# Value: your_api_key_here
